# Better Auth — local PostgreSQL is the preferred authentication database.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:18473
WEBWATCH_LOCAL_DATABASE_URL=postgresql://webwatch_app:YOUR_PASSWORD@127.0.0.1:55432/webwatch

# Optional fallback database URL. WEBWATCH_LOCAL_DATABASE_URL takes precedence.
# Do not expose this value through a VITE_ or PUBLIC_ variable.
DATABASE_URL=

# Supabase project configuration is retained for the parcel-storage integration.
# Never put a service_role key in a browser-exposed variable.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
